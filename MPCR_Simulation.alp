						<Parameter>
							<Name><![CDATA[onExitCopy]]></Name>
							<Value Class="CodeValue">
								<Code><![CDATA[agent.size = original.packageType;

if (agent.size.equals("large")) {
    agent.setWidth(triangular(0.8, 1.2, 1.5));
    agent.setLength(agent.getWidth());
    agent.setHeight(triangular(0.4, 0.8, 1.1));
} else {
    agent.setWidth(triangular(0.3, 0.5, 0.8));
    agent.setLength(agent.getWidth());
    agent.setHeight(triangular(0.2, 0.4, 0.7));
}

agent.volume = agent.getWidth() * agent.getLength() * agent.getHeight();

agent.timeBorn = time();]]></Code>
							</Value>
