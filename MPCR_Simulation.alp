			<Events>
				<Event>
					<Id>1778475880334</Id>
					<Name><![CDATA[eventDailyReset]]></Name>
					<X>-480</X><Y>1140</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Properties TriggerType="timeout" Mode="cyclic">
						<Timeout Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="TimeUnits"><![CDATA[MINUTE]]></Unit>
						</Timeout>
						<Rate Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="RateUnits"><![CDATA[PER_MINUTE]]></Unit>
						</Rate>
						<Id>1778475880332</Id>
						<OccurrenceAtTime>true</OccurrenceAtTime>
						<OccurrenceDate>1778486400000</OccurrenceDate>
						<OccurrenceTime Class="CodeUnitValue">
							<Code><![CDATA[19.5]]></Code>
							<Unit Class="TimeUnits"><![CDATA[HOUR]]></Unit>
						</OccurrenceTime>
						<RecurrenceCode Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="TimeUnits"><![CDATA[DAY]]></Unit>
						</RecurrenceCode>
						<Condition><![CDATA[false]]></Condition>
					</Properties>
					<Action><![CDATA[currentDay++;
numTrucksDispatchedToday = 0;
if (waitAtDock.size() == 0 && sourceTrucks.size() == 0) {
    isTruckRequested = false;
}]]></Action>
				</Event>
			</Events>
			<Functions>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1778289643473</Id>
					<Name><![CDATA[navigate]]></Name>
					<X>-480</X><Y>760</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[viewArea]]></Name>
						<Type><![CDATA[ViewArea]]></Type>
					</Parameter>
					<Body><![CDATA[selectedViewArea = viewArea;
viewArea.navigateTo();
groupMainMenu.setPos( viewArea.getX(), viewArea.getY() );]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[RectangularNode]]></ReturnType>
					<Id>1778400305061</Id>
					<Name><![CDATA[getTargetStorageNode]]></Name>
					<X>-480</X><Y>1010</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[agent]]></Name>
						<Type><![CDATA[Package]]></Type>
					</Parameter>
					<Body><![CDATA[if (stZoneCurVol1 + agent.volume <= stZoneMaxVol1) {
    agent.assignedZone = 1;
    return storageZone1;
} 
else if (stZoneCurVol2 + agent.volume <= stZoneMaxVol2) {
    agent.assignedZone = 2;
    return storageZone2;
} 
else if (stZoneCurVol3 + agent.volume <= stZoneMaxVol3) {
    agent.assignedZone = 3;
    return storageZone3;
} 
else if (stZoneCurVol4 + agent.volume <= stZoneMaxVol4) {
    agent.assignedZone = 4;
    return storageZone4;
} 
else if (stZoneCurVol5 + agent.volume <= stZoneMaxVol5) {
    agent.assignedZone = 5;
    return storageZone5;
} 
else {
    agent.assignedZone = 6;
    return storageZone6;
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1778404960653</Id>
					<Name><![CDATA[getTotalStoredVolume]]></Name>
					<X>-480</X><Y>1040</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[return stZoneCurVol1 + stZoneCurVol2 + stZoneCurVol3 + stZoneCurVol4 + stZoneCurVol5 + stZoneCurVol6;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1778408640684</Id>
					<Name><![CDATA[checkAndTriggerLoading]]></Name>
					<X>-480</X><Y>1070</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[if (waitAtDock.size() > 0) {
    Truck currentTruck = waitAtDock.get(0);

    // If already marked complete, stop processing to save CPU
    if (currentTruck.isLoadingComplete) return;

    int assignedThisRun = 0;

    for (int i = 0; i < waitReadyForLoading.size(); i++) {
        Package p = waitReadyForLoading.get(i);
        if (p.targetTruck != null) continue;

        if (currentTruck.currentLoadVolume + p.volume <= currentTruck.maxLoadVolume) {
            p.targetTruck = currentTruck;
            currentTruck.currentLoadVolume += p.volume;
            waitReadyForLoading.free(p);
            assignedThisRun++;
        } else {
            currentTruck.isLoadingComplete = true; 
            traceln("🚚 Truck " + currentTruck.getIndex() + " is Satisfied at " + currentTruck.currentLoadVolume);
            break; 
        }
    }
}]]></Body>
				</Function>
			</Functions>
