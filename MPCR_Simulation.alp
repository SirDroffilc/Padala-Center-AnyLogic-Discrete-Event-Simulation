				<EmbeddedObject>
					<Id>1778408249329</Id>
					<Name><![CDATA[storageCongestionDelay2]]></Name>
					<X>1950</X><Y>910</Y>
					<Label><X>0</X><Y>-10</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<ActiveObjectClass>
						<PackageName><![CDATA[com.anylogic.libraries.processmodeling]]></PackageName>
						<ClassName><![CDATA[Delay]]></ClassName>
					</ActiveObjectClass>
					<GenericParameterSubstitute>
						<GenericParameterSubstituteReference>
							<PackageName><![CDATA[com.anylogic.libraries.processmodeling]]></PackageName>
							<ClassName><![CDATA[Delay]]></ClassName>
							<ItemName><![CDATA[1412336242930]]></ItemName>
						</GenericParameterSubstituteReference>
					</GenericParameterSubstitute>
					<Parameters>
						<Parameter>
							<Name><![CDATA[type]]></Name>
						</Parameter>
						<Parameter>
							<Name><![CDATA[delayTime]]></Name>
							<Value Class="CodeUnitValue">
								<Code><![CDATA[// Base delay + (Variable delay based on % filled)
// Formula: Base (1 min) + 5 mins * (CurrentVol / MaxVol)

agent.assignedZone == 1 ? (1 + storageDelayTime * (stZoneCurVol1 / stZoneMaxVol1)) :
agent.assignedZone == 2 ? (1 + storageDelayTime * (stZoneCurVol2 / stZoneMaxVol2)) :
agent.assignedZone == 3 ? (1 + storageDelayTime * (stZoneCurVol3 / stZoneMaxVol3)) :
agent.assignedZone == 4 ? (1 + storageDelayTime * (stZoneCurVol4 / stZoneMaxVol4)) :
agent.assignedZone == 5 ? (1 + storageDelayTime * (stZoneCurVol5 / stZoneMaxVol5)) :
agent.assignedZone == 6 ? (1 + storageDelayTime * (stZoneCurVol6 / stZoneMaxVol6)) :
1.0; // Default for other zones]]></Code>
								<Unit Class="TimeUnits"><![CDATA[MINUTE]]></Unit>
							</Value>
