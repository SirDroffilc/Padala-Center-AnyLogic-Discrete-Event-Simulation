						<Parameter>
							<Name><![CDATA[onEnter]]></Name>
							<Value Class="CodeValue">
								<Code><![CDATA[histStorageTime.add(time() - agent.timePackaged);
agent.timeStored = time();

switch(agent.assignedZone) {
    case 1: stZoneCurVol1 += agent.volume; break;
    case 2: stZoneCurVol2 += agent.volume; break;
    case 3: stZoneCurVol3 += agent.volume; break;
    case 4: stZoneCurVol4 += agent.volume; break;
    case 5: stZoneCurVol5 += agent.volume; break;
    case 6: stZoneCurVol6 += agent.volume; break;
}

double totalVol = getTotalStoredVolume();
double threshold = 0.90 * 70.0; // 75% of a 30m³ truck capacity

if (totalVol >= threshold && numTrucksDispatchedToday < maxTrucks && !isTruckRequested) {
    isTruckRequested = true;
    numTrucksDispatchedToday++;
    sourceTrucks.inject(1); 
}]]></Code>
							</Value>
						</Parameter>
