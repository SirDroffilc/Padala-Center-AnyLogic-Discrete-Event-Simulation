			<Name><![CDATA[Main]]></Name>
			<StartupCode><![CDATA[stZoneMaxVol1 = Math.round(((storageZone1.getWidth() / 10.0) * (storageZone1.getHeight() / 10.0) * 2.5) * 100.0) / 100.0;
stZoneMaxVol2 = Math.round(((storageZone2.getWidth() / 10.0) * (storageZone2.getHeight() / 10.0) * 2.5) * 100.0) / 100.0;
stZoneMaxVol3 = Math.round(((storageZone3.getWidth() / 10.0) * (storageZone3.getHeight() / 10.0) * 2.5) * 100.0) / 100.0;
stZoneMaxVol4 = Math.round(((storageZone4.getWidth() / 10.0) * (storageZone4.getHeight() / 10.0) * 2.5) * 100.0) / 100.0;
stZoneMaxVol5 = Math.round(((storageZone5.getWidth() / 10.0) * (storageZone5.getHeight() / 10.0) * 2.5) * 100.0) / 100.0;
stZoneMaxVol6 = Math.round(((storageZone6.getWidth() / 10.0) * (storageZone6.getHeight() / 10.0) * 2.5) * 100.0) / 100.0;

maxStorageVolume = stZoneMaxVol1 + stZoneMaxVol2 + stZoneMaxVol3 + stZoneMaxVol4 + stZoneMaxVol5 + stZoneMaxVol6;]]></StartupCode>
