				<EmbeddedObject>
					<Id>1778408088282</Id>
					<Name><![CDATA[sinkPackages]]></Name>
					<X>2430</X><Y>920</Y>
					<Label><X>-20</X><Y>-20</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<ActiveObjectClass>
						<PackageName><![CDATA[com.anylogic.libraries.processmodeling]]></PackageName>
						<ClassName><![CDATA[Sink]]></ClassName>
					</ActiveObjectClass>
					<GenericParameterSubstitute>
						<GenericParameterSubstituteReference>
							<PackageName><![CDATA[com.anylogic.libraries.processmodeling]]></PackageName>
							<ClassName><![CDATA[Sink]]></ClassName>
							<ItemName><![CDATA[1412336242929]]></ItemName>
						</GenericParameterSubstituteReference>
					</GenericParameterSubstitute>
					<Parameters>
						<Parameter>
							<Name><![CDATA[onEnter]]></Name>
							<Value Class="CodeValue">
								<Code><![CDATA[numPackagesInLoading--;
numPackagesExited++;

histPackageTurnAround.add(time() - agent.timeBorn);

// 1. Update Physical Volume
agent.targetTruck.physicalLoadVolume += agent.volume;

// 2. Storage zone subtraction logic
switch(agent.assignedZone) {
    case 1: stZoneCurVol1 -= agent.volume; break;
    case 2: stZoneCurVol2 -= agent.volume; break;
    case 3: stZoneCurVol3 -= agent.volume; break;
    case 4: stZoneCurVol4 -= agent.volume; break;
    case 5: stZoneCurVol5 -= agent.volume; break;
    case 6: stZoneCurVol6 -= agent.volume; break;
}

// 3. Departure Logic: Leave ONLY when physical volume is full
double physical = agent.targetTruck.physicalLoadVolume;
double planned = agent.targetTruck.currentLoadVolume;
double max = agent.targetTruck.maxLoadVolume;

// RELEASE IF:
// A) It's physically near the absolute max (e.g., 69.95+)
// OR 
// B) All planned packages have arrived AND the function said "no more fit"
if (physical >= max - 0.05 || (agent.targetTruck.isLoadingComplete && physical >= planned - 0.01)) {
    traceln("🚛 DISPATCH: Truck " + agent.targetTruck.getIndex() + " leaving with " + physical + "m³");
    waitAtDock.free(agent.targetTruck);
    isTruckRequested = false; 
}]]></Code>
							</Value>
						</Parameter>
						<Parameter>
							<Name><![CDATA[destroyEntity]]></Name>
						</Parameter>
